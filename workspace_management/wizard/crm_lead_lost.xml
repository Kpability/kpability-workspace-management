<odoo>
    <record id="crm_lead_lost_view_form" model="ir.ui.view">
        <field name="name">crm.lead.lost.form.workspace</field>
        <field name="model">crm.lead.lost</field>
        <field name="inherit_id" ref="crm.crm_lead_lost_view_form"/>
        <field name="arch" type="xml">
            <field name="lead_ids" position="after">
                <field name="lead_stage_ids" invisible="1"/>
            </field>
            <field name="lost_reason_id" position="attributes">
                <attribute name="required">not s_lost_reason_custom</attribute>
                <attribute name="domain">
                    ['|', ('stage_ids', '=', False), ('stage_ids', 'in', lead_stage_ids)]
                </attribute>
            </field>
            <field name="lost_reason_id" position="after">
                <div class="mt-3">
                    <field
                            name="s_lost_reason_custom"
                            widget="reason_custom"
                            placeholder="Or type another reason..."
                            required="not lost_reason_id"
                            class="w-100"
                    />
                </div>
            </field>
            <xpath expr="//field[@name='lost_feedback']/.." position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>
