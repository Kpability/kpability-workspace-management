<odoo>
    <template id="snippets" inherit_id="website.snippets" active="False">
        <xpath expr="//t[@t-snippet='website.s_website_form_info']" position="after">
        </xpath>
    </template>
    <!-- A template's active attribute applies only on installation, not update. -->
    <record id="snippets" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
</odoo>
