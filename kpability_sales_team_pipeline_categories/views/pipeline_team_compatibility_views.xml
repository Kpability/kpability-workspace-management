<odoo>
    <record id="crm_lead_view_list_compatibility" model="ir.ui.view">
        <field name="name">crm.lead.list.pipeline.team.compatibility</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <list string="Pipeline Team Compatibility" create="0" edit="0" delete="0" import="0"
                js_class="pipeline_team_compatibility_list">
                <field name="name"/>
                <field name="type"/>
                <field name="team_id"/>
                <field name="pipeline_category_id"/>
                <field name="stage_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="crm_lead_view_form_compatibility" model="ir.ui.view">
        <field name="name">crm.lead.form.pipeline.team.compatibility</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="Pipeline Team Compatibility" create="0" edit="0" delete="0" duplicate="0"
                js_class="pipeline_team_compatibility_form">
                <sheet>
                    <p class="text-muted">Read-only rollout report. Configure the team mapping or explicitly reclassify the record in CRM. Archived teams and categories remain valid historical references.</p>
                    <group>
                        <field name="name"/>
                        <field name="type"/>
                        <field name="team_id" options="{'no_open': True}"/>
                        <field name="pipeline_category_id" options="{'no_open': True}"/>
                        <field name="stage_id" options="{'no_open': True}"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_pipeline_team_compatibility" model="ir.actions.server">
        <field name="name">Pipeline Team Compatibility</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_pipeline_team_compatibility()</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <menuitem id="menu_pipeline_team_compatibility" name="Pipeline Team Compatibility"
        parent="crm.menu_crm_config_lead" action="action_pipeline_team_compatibility"
        sequence="3" groups="sales_team.group_sale_manager"/>
</odoo>
