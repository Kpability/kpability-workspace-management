<odoo>
    <record id="crm_stage_template_view_search" model="ir.ui.view">
        <field name="name">crm.stage.template.search</field>
        <field name="model">crm.stage.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="stage_id"/>
                <field name="activity_plan_ids"/>
                <field name="mail_template_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="crm_stage_template_view_list" model="ir.ui.view">
        <field name="name">crm.stage.template.list</field>
        <field name="model">crm.stage.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="n_sequence" widget="handle"/>
                <field name="stage_id"/>
                <field name="activity_plan_ids" widget="many2many_tags"/>
                <field name="mail_template_ids" widget="many2many_tags"/>
                <field
                        name="s_domain"
                        widget="domain"
                        options="{'model': 'crm.lead', 'in_dialog': True, 'foldable': True}"
                />
                <field name="n_activity_plan_count" string="Activities"/>
                <field name="n_mail_template_count" string="Emails"/>
            </list>
        </field>
    </record>

    <record id="crm_stage_template_view_form" model="ir.ui.view">
        <field name="name">crm.stage.template.form</field>
        <field name="model">crm.stage.template</field>
        <field name="arch" type="xml">
            <form string="Stage Template">
                <sheet>
                    <div class="oe_title">
                        <label for="stage_id"/>
                        <h1>
                            <field name="stage_id" placeholder="Select a stage"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="n_sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field
                                    name="s_domain"
                                    widget="domain"
                                    options="{'model': 'crm.lead', 'in_dialog': True, 'foldable': True}"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Activities" name="activities">
                            <field
                                    name="activity_plan_ids"
                                    context="{'default_res_model': 'crm.lead'}"
                            >
                                <list>
                                    <field name="name"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </list>
                            </field>
                        </page>
                        <page string="Email Templates" name="email_templates">
                            <field
                                    name="mail_template_ids"
                                    context="{'default_model': 'crm.lead'}"
                            >
                                <list>
                                    <field name="name"/>
                                    <field name="subject"/>
                                    <field name="lang"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_stage_template_action" model="ir.actions.act_window">
        <field name="name">Stage Templates</field>
        <field name="res_model">crm.stage.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Stage Template
            </p>
            <p>
                Centralize activity plans and email templates for each CRM pipeline
                stage. Optional Condition must match before activities or emails run.
            </p>
        </field>
    </record>
</odoo>
