<odoo>
    <record id="crm_lead_won_view_form" model="ir.ui.view">
        <field name="name">crm.lead.won.form</field>
        <field name="model">crm.lead.won</field>
        <field name="arch" type="xml">
            <form string="Won Lead">
                <field name="lead_id" invisible="1"/>
                <field name="stage_id" invisible="1"/>
                <field name="has_won_reasons" invisible="1"/>
                <div class="alert alert-info mb-0" role="alert" invisible="has_won_reasons">
                    No Won Reasons are configured for this stage.
                    Add them in CRM → Configuration → Won Reasons.
                </div>
                <field
                        name="won_reason_id"
                        placeholder="Select a Won Reason..."
                        widget="badges_many2one"
                        options="{'badge_limit': 8}"
                        domain="['|', ('stage_ids', '=', False), ('stage_ids', 'in', [stage_id])]"
                />
                <div class="mt-3">
                    <field
                            name="s_won_reason_custom"
                            placeholder="Add more details (optional)..."
                            class="w-100"
                    />
                </div>
                <footer>
                    <button name="action_won_reason_apply" string="Mark as Won" type="object" class="btn-primary" data-hotkey="q"/>
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="crm_lead_won_action" model="ir.actions.act_window">
        <field name="name">Mark Won</field>
        <field name="res_model">crm.lead.won</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="crm_lead_won_view_form"/>
        <field name="target">new</field>
        <field name="context">{
            'dialog_size': 'medium',
            'default_lead_id': active_id,
        }</field>
    </record>
</odoo>
