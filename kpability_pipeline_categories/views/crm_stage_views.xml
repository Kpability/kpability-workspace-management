<odoo>
    <record id="crm_stage_view_list_reorder" model="ir.ui.view">
        <field name="name">crm.stage.list.pipeline.reorder</field>
        <field name="model">crm.stage</field>
        <field name="arch" type="xml">
            <list string="Pipeline Stages" create="0">
                <field name="sequence" widget="handle"/>
                <field name="name" readonly="True"/>
            </list>
        </field>
    </record>

    <record id="crm_stage_view_form_pipeline_category" model="ir.ui.view">
        <field name="name">crm.stage.form.pipeline.category</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <field name="is_won" position="before">
                <field name="pipeline_category_ids" widget="many2many_tags" readonly="True"
                    context="{'active_test': False}" options="{'no_create': True, 'no_open': True}"/>
            </field>
        </field>
    </record>

    <record id="crm_stage_view_list_pipeline_category" model="ir.ui.view">
        <field name="name">crm.stage.list.pipeline.category</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_tree"/>
        <field name="arch" type="xml">
            <field name="team_ids" position="after">
                <field name="pipeline_category_ids" widget="many2many_tags" optional="hide" readonly="True"
                    context="{'active_test': False}"/>
            </field>
        </field>
    </record>
</odoo>
